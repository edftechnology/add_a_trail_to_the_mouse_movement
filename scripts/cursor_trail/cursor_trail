#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${HOME}/.local/opt/cursor_trail"
DEPS_LIB_DIR="${HOME}/.local/opt/cursor_trail_deps/usr/lib/x86_64-linux-gnu"

export LD_LIBRARY_PATH="${DEPS_LIB_DIR}:${LD_LIBRARY_PATH:-}"

cd "${APP_DIR}"
exec "${APP_DIR}/CursorTrail" --config "${APP_DIR}/config.ini"
